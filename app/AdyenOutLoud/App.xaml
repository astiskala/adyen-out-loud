<?xml version="1.0" encoding="UTF-8" ?>
<Application
    x:Class="AdyenOutLoud.App"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <Application.Resources>
        <!-- Defined inline (not as Source= dictionaries): each separate dictionary file makes the MAUI
             XAML generator emit an undocumented public class, which fails CS1591 under warnings-as-errors. -->
        <ResourceDictionary>
            <!-- Palette. Each role has a light and a dark value; styles pick one with AppThemeBinding so the
                 app follows the system appearance. Text colors meet WCAG AA (4.5:1) on every surface they sit on. -->
            <Color x:Key="AdyenGreen">#0ABF53</Color>
            <Color x:Key="OnAccent">#06130B</Color>

            <Color x:Key="PageLight">#F3F5F6</Color>
            <Color x:Key="PageDark">#0B1014</Color>
            <Color x:Key="SurfaceLight">#FFFFFF</Color>
            <Color x:Key="SurfaceDark">#1A242C</Color>
            <Color x:Key="SurfaceSunkenLight">#E9EDEF</Color>
            <Color x:Key="SurfaceSunkenDark">#141C22</Color>
            <Color x:Key="TextLight">#0B1014</Color>
            <Color x:Key="TextDark">#F5F7F8</Color>
            <Color x:Key="MutedLight">#56646D</Color>
            <Color x:Key="MutedDark">#98A6AF</Color>
            <Color x:Key="RuleLight">#D5DCE0</Color>
            <Color x:Key="RuleDark">#2A3740</Color>
            <!-- Adyen green is too light for text on a light background; this darker shade keeps 4.5:1. -->
            <Color x:Key="AccentTextLight">#007A33</Color>
            <Color x:Key="AccentTextDark">#0ABF53</Color>

            <Style TargetType="ContentPage" ApplyToDerivedTypes="True">
                <Setter Property="Shell.NavBarIsVisible" Value="False" />
                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource PageLight}, Dark={StaticResource PageDark}}" />
            </Style>

            <Style x:Key="Eyebrow" TargetType="Label"><Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource AccentTextLight}, Dark={StaticResource AccentTextDark}}" /><Setter Property="FontAttributes" Value="Bold" /><Setter Property="FontSize" Value="13" /><Setter Property="CharacterSpacing" Value="3" /></Style>
            <Style x:Key="Hero" TargetType="Label"><Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" /><Setter Property="FontAttributes" Value="Bold" /><Setter Property="FontSize" Value="48" /><Setter Property="LineHeight" Value="0.95" /></Style>
            <Style x:Key="Subtitle" TargetType="Label"><Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource MutedLight}, Dark={StaticResource MutedDark}}" /><Setter Property="FontSize" Value="17" /><Setter Property="LineHeight" Value="1.35" /></Style>
            <Style x:Key="Body" TargetType="Label"><Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource MutedLight}, Dark={StaticResource MutedDark}}" /><Setter Property="FontSize" Value="14" /><Setter Property="LineHeight" Value="1.35" /></Style>
            <Style x:Key="Caption" TargetType="Label"><Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource MutedLight}, Dark={StaticResource MutedDark}}" /><Setter Property="FontSize" Value="12" /><Setter Property="LineHeight" Value="1.3" /></Style>
            <Style x:Key="StatusTitle" TargetType="Label"><Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" /><Setter Property="FontAttributes" Value="Bold" /><Setter Property="FontSize" Value="18" /></Style>
            <Style x:Key="SectionTitle" TargetType="Label"><Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" /><Setter Property="FontAttributes" Value="Bold" /><Setter Property="FontSize" Value="22" /></Style>
            <Style x:Key="FieldLabel" TargetType="Label"><Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource MutedLight}, Dark={StaticResource MutedDark}}" /><Setter Property="FontAttributes" Value="Bold" /><Setter Property="FontSize" Value="11" /><Setter Property="CharacterSpacing" Value="1.5" /></Style>
            <Style x:Key="LatestEvent" TargetType="Label"><Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" /><Setter Property="FontSize" Value="15" /><Setter Property="LineHeight" Value="1.35" /></Style>
            <Style x:Key="Diagnostic" TargetType="Label"><Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" /><Setter Property="FontFamily" Value="monospace" /><Setter Property="FontSize" Value="12" /><Setter Property="LineHeight" Value="1.3" /></Style>
            <Style x:Key="Footer" TargetType="Label"><Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource MutedLight}, Dark={StaticResource MutedDark}}" /><Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceSunkenLight}, Dark={StaticResource SurfaceSunkenDark}}" /><Setter Property="HorizontalTextAlignment" Value="Center" /><Setter Property="Padding" Value="24,14" /><Setter Property="FontSize" Value="12" /></Style>
            <Style x:Key="LinkSpan" TargetType="Span"><Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource AccentTextLight}, Dark={StaticResource AccentTextDark}}" /><Setter Property="TextDecorations" Value="Underline" /></Style>

            <Style x:Key="Panel" TargetType="Border"><Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}" /><Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource RuleLight}, Dark={StaticResource RuleDark}}" /><Setter Property="StrokeThickness" Value="1" /><Setter Property="Padding" Value="20" /><Setter Property="StrokeShape"><Setter.Value><RoundRectangle CornerRadius="16" /></Setter.Value></Setter></Style>
            <Style x:Key="DiagnosticPanel" TargetType="Border" BasedOn="{StaticResource Panel}"><Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceSunkenLight}, Dark={StaticResource SurfaceSunkenDark}}" /></Style>
            <!-- Entries and pickers are borderless (see InputChrome); this Border draws their field. -->
            <Style x:Key="InputBorder" TargetType="Border"><Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}" /><Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource RuleLight}, Dark={StaticResource RuleDark}}" /><Setter Property="StrokeThickness" Value="1" /><Setter Property="Padding" Value="12,0" /><Setter Property="HeightRequest" Value="48" /><Setter Property="StrokeShape"><Setter.Value><RoundRectangle CornerRadius="12" /></Setter.Value></Setter></Style>

            <Style TargetType="Entry">
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="VerticalOptions" Value="Center" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" />
                <Setter Property="PlaceholderColor" Value="{AppThemeBinding Light={StaticResource MutedLight}, Dark={StaticResource MutedDark}}" />
            </Style>
            <Style TargetType="Picker">
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="VerticalOptions" Value="Center" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" />
                <Setter Property="TitleColor" Value="{AppThemeBinding Light={StaticResource MutedLight}, Dark={StaticResource MutedDark}}" />
            </Style>

            <Style TargetType="Button">
                <Setter Property="BackgroundColor" Value="{StaticResource AdyenGreen}" />
                <Setter Property="TextColor" Value="{StaticResource OnAccent}" />
                <Setter Property="BorderWidth" Value="0" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="HeightRequest" Value="48" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="20,0" />
                <Setter Property="VisualStateManager.VisualStateGroups">
                    <VisualStateGroupList>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal" />
                            <VisualState x:Name="Disabled"><VisualState.Setters><Setter Property="Opacity" Value="0.5" /></VisualState.Setters></VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </Setter>
            </Style>
            <Style x:Key="SecondaryButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" />
                <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource RuleLight}, Dark={StaticResource RuleDark}}" />
                <Setter Property="BorderWidth" Value="1" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="HeightRequest" Value="48" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="20,0" />
                <Setter Property="VisualStateManager.VisualStateGroups">
                    <VisualStateGroupList>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal" />
                            <VisualState x:Name="Disabled"><VisualState.Setters><Setter Property="Opacity" Value="0.5" /></VisualState.Setters></VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
