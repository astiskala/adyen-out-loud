# Auto-detect text files and normalize line endings to LF in the repository.
* text=auto eol=lf

# Sources that must always be LF.
*.cs text eol=lf
*.csproj text eol=lf
*.xaml text eol=lf
*.sln text eol=lf
*.slnx text eol=lf
*.props text eol=lf
*.targets text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.json text eol=lf
*.jsonc text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.resx text eol=lf
*.sh text eol=lf

# Windows-only scripts must keep CRLF; that's the native and expected line ending there.
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary assets — never diff, never normalize.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg text eol=lf
*.woff binary
*.woff2 binary
*.keystore binary
*.p12 binary
*.pfx binary

# Keep generated/vendored files out of GitHub's language and diff statistics.
worker/package-lock.json linguist-generated=true
app/**/obj/** linguist-generated=true
app/**/bin/** linguist-generated=true
