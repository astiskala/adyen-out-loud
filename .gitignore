# --- Local agent worktrees ---
.worktrees/

# --- .NET / MAUI ---
bin/
obj/
*.user
*.userosscache
*.suo
.vs/
.vscode/*
!.vscode/extensions.json
*.binlog
*.dotCover
TestResults/
coverage/
StrykerOutput/
