{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "adyenoutloud",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-18",
  "vars": {
    // Webhooks are accepted only from the IP addresses this host resolves to. Empty disables the check.
    "ADYEN_WEBHOOK_HOST": "out.adyen.com",
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "PAYMENT_CHANNELS",
        "class_name": "RelayObject",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RelayObject"],
    },
  ],
}
